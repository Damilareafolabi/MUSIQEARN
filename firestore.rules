rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 32 &&
             data.level is int && data.level >= 1 &&
             data.xp is int && data.xp >= 0 &&
             data.musizCoins is int && data.musizCoins >= 0 &&
             data.currentStreak is int && data.currentStreak >= 0 &&
             data.totalGamesPlayed is int && data.totalGamesPlayed >= 0 &&
             data.totalWins is int && data.totalWins >= 0;
    }

    function isValidLeaderboard(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.username is string &&
             data.country is string &&
             data.flag is string &&
             data.score is int && data.score >= 0 &&
             data.streak is int && data.streak >= 0;
    }

    function isValidBattle(data) {
      return data.battleId is string &&
             data.creatorUserId is string &&
             data.creatorUsername is string &&
             data.status in ['WAITING', 'IN_PROGRESS', 'COMPLETED'] &&
             data.inviteCode is string;
    }

    function isValidSubmission(data) {
      return data.id is string &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.artistName is string && data.artistName.size() >= 2 &&
             data.songTitle is string && data.songTitle.size() >= 1 &&
             data.rightsOwnershipConfirmed == true &&
             data.status in ['PENDING_REVIEW', 'APPROVED_LIVE', 'REJECTED'];
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false;
    }

    // Leaderboards Collection
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
                            request.resource.data.userId == request.auth.uid &&
                            isValidLeaderboard(request.resource.data);
      allow delete: if false;
    }

    // Multiplayer Battles Collection
    match /battles/{battleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.creatorUserId == request.auth.uid &&
                       isValidBattle(request.resource.data);
      allow update: if isAuthenticated() &&
                       (request.auth.uid == resource.data.creatorUserId ||
                        request.auth.uid == request.resource.data.opponentUserId) &&
                       isValidBattle(request.resource.data);
      allow delete: if false;
    }

    // Artist Submissions Collection
    match /artist_submissions/{submissionId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidSubmission(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidSubmission(request.resource.data);
      allow delete: if false;
    }
  }
}
